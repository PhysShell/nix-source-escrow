#!/usr/bin/env bash
#
# nse-pg -- the policy-governed line's tooling.
#
# A SECOND executable, beside bin/nix-source-escrow, and deliberately not a
# subcommand of it. The closed line's tool is an INSTRUMENT this line reuses;
# it is not this line's judge, and merging the two would make the frozen tool's
# behaviour a function of this experiment's code.
#
# See experiments/policy-governed/PREREG.md. The pre-registration is the
# contract; this is one implementation of it.

set -euo pipefail

NSE_PG_SELF=${BASH_SOURCE[0]}
while [ -L "$NSE_PG_SELF" ]; do NSE_PG_SELF=$(readlink -f "$NSE_PG_SELF"); done
NSE_PG_SELF=$(cd "$(dirname "$NSE_PG_SELF")" && pwd)/$(basename "$NSE_PG_SELF")
export NSE_PG_SELF
NSE_ROOT=$(cd "$(dirname "$NSE_PG_SELF")/.." && pwd)
export NSE_ROOT

# shellcheck source=../lib/common.sh
. "$NSE_ROOT/lib/common.sh"
# shellcheck source=../lib/pg-common.sh
. "$NSE_ROOT/lib/pg-common.sh"
# shellcheck source=../lib/pg-facts.sh
. "$NSE_ROOT/lib/pg-facts.sh"
# shellcheck source=../lib/pg-qualify.sh
. "$NSE_ROOT/lib/pg-qualify.sh"
# shellcheck source=../lib/pg-annotate.sh
. "$NSE_ROOT/lib/pg-annotate.sh"
# shellcheck source=../lib/pg-digest.sh
. "$NSE_ROOT/lib/pg-digest.sh"
# shellcheck source=../lib/pg-policy.sh
. "$NSE_ROOT/lib/pg-policy.sh"
# shellcheck source=../lib/pg-gate.sh
. "$NSE_ROOT/lib/pg-gate.sh"

usage() {
  cat >&2 <<'USAGE'
usage: nse-pg <command> [options]

commands:
  qualify-facts   measure which GitHub facts are visible in the derivation
                  document on THIS Nix, with provenance, and classify a bare
                  `escrow = true` as REJECTED / DROPPED / SURVIVED.
                  PREREG.md §3.3, §4, §5.
  qualify-annotation
                  measure what a plain `overrideAttrs` annotation moves and
                  what it does not: three .drv identities, three outputs, the
                  realised set, and whether anything had to be rebuilt.
                  PREREG.md §3.4-§3.6, claim C4.
  digest          print the four typed digests of a facts document, and the
                  projection each one is computed over. PREREG.md §12.
  digest-compare  name the SHAPE of the difference between two digest
                  documents, rather than reporting that something changed.
  policy-load     read a policy TOML into JSON. Anything this reader does not
                  fully understand is a POLICY_PARSE_ERROR, never an ignored
                  line. PREREG.md §13.
  gate            render a verdict on an UNTRUSTED candidate. Policy and judge
                  come from the trusted root; the graph, and only the graph,
                  comes from the candidate root. PREREG.md §8, §10.
  decide          FACTS + POLICY -> DECISIONS, with matched-rule provenance and
                  the trusted policy revision on every decision.

options:
  --flake REF     the qualification fixture to measure
                  (default: path:<repo>/experiments/policy-governed/fixtures/qualification)
  --facts FILE    facts document (digest, decide)
  --policy FILE   policy TOML (policy-load) or loaded policy JSON (decide)
  --trusted-root D    the root the policy and the judge are read from (gate)
  --candidate-root D  the root the dependency graph is read from (gate)
  --trusted-rev R     revision of the trusted root, if git cannot say
  --candidate-rev R   revision of the candidate root, if git cannot say
  --policy-rev R  the revision the policy was read from; recorded on every
                  decision, so a verdict says WHICH policy produced it
  --base FILE     base digests (digest-compare)
  --head FILE     head digests (digest-compare)
  --out FILE      where the report is written
                  (default: experiments/policy-governed/results/facts-qualification.json)
  -h, --help      this text

exit status:
  0  the measurement completed
  1  a check said no
  2  usage error
  3  CHECKER_ERROR -- the check could not run. A separate state on purpose:
     "the check says no" and "the check could not run" are different results.
USAGE
}

[ $# -ge 1 ] || { usage; exit "$NSE_PG_USAGE"; }
case $1 in -h|--help|help) usage; exit 0 ;; esac
cmd=$1; shift

pg_flake=""
pg_out=""
pg_facts=""
pg_policy=""
pg_policy_rev="UNKNOWN"
pg_trusted_root=""
pg_candidate_root=""
pg_trusted_rev=""
pg_candidate_rev=""
pg_base=""
pg_head=""
while [ $# -gt 0 ]; do
  case $1 in
    --flake) [ $# -ge 2 ] || { printf 'nse-pg: --flake needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_flake=$2; shift 2 ;;
    --out)   [ $# -ge 2 ] || { printf 'nse-pg: --out needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_out=$(nse_abspath "$2"); shift 2 ;;
    --facts) [ $# -ge 2 ] || { printf 'nse-pg: --facts needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_facts=$(nse_abspath "$2"); shift 2 ;;
    --policy) [ $# -ge 2 ] || { printf 'nse-pg: --policy needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_policy=$(nse_abspath "$2"); shift 2 ;;
    --policy-rev) [ $# -ge 2 ] || { printf 'nse-pg: --policy-rev needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_policy_rev=$2; shift 2 ;;
    --trusted-root) [ $# -ge 2 ] || { printf 'nse-pg: --trusted-root needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_trusted_root=$(nse_abspath "$2"); shift 2 ;;
    --candidate-root) [ $# -ge 2 ] || { printf 'nse-pg: --candidate-root needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_candidate_root=$(nse_abspath "$2"); shift 2 ;;
    --trusted-rev) [ $# -ge 2 ] || { printf 'nse-pg: --trusted-rev needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_trusted_rev=$2; shift 2 ;;
    --candidate-rev) [ $# -ge 2 ] || { printf 'nse-pg: --candidate-rev needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_candidate_rev=$2; shift 2 ;;
    --base)  [ $# -ge 2 ] || { printf 'nse-pg: --base needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_base=$(nse_abspath "$2"); shift 2 ;;
    --head)  [ $# -ge 2 ] || { printf 'nse-pg: --head needs a value\n' >&2; exit "$NSE_PG_USAGE"; }
             pg_head=$(nse_abspath "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'nse-pg: unknown option %s\n' "$1" >&2; usage; exit "$NSE_PG_USAGE" ;;
  esac
done

case $cmd in
  qualify-facts)
    nse_require_cmd nix jq
    : "${pg_flake:=path:$NSE_ROOT/experiments/policy-governed/fixtures/qualification}"
    : "${pg_out:=$NSE_ROOT/experiments/policy-governed/results/facts-qualification.json}"
    nse_pg_qualify_facts "$pg_flake" "$pg_out"
    printf 'wrote %s\n' "$pg_out" >&2
    ;;
  qualify-annotation)
    nse_require_cmd nix jq nix-store
    : "${pg_flake:=path:$NSE_ROOT/experiments/policy-governed/fixtures/qualification}"
    : "${pg_out:=$NSE_ROOT/experiments/policy-governed/results/annotation-qualification.json}"
    nse_pg_qualify_annotation "$pg_flake" "$pg_out"
    printf 'wrote %s\n' "$pg_out" >&2
    ;;
  digest)
    nse_require_cmd jq
    [ -n "$pg_facts" ] || { printf 'nse-pg: digest needs --facts FILE\n' >&2; exit "$NSE_PG_USAGE"; }
    [ -f "$pg_facts" ] || { printf 'nse-pg: no such facts document: %s\n' "$pg_facts" >&2; exit "$NSE_PG_FAIL"; }
    if [ -n "$pg_out" ]; then nse_pg_digests "$pg_facts" | nse_pg_write_json "$pg_out"
    else nse_pg_digests "$pg_facts"; fi
    ;;
  digest-compare)
    nse_require_cmd jq
    { [ -n "$pg_base" ] && [ -n "$pg_head" ]; } \
      || { printf 'nse-pg: digest-compare needs --base FILE and --head FILE\n' >&2; exit "$NSE_PG_USAGE"; }
    nse_pg_digest_compare "$pg_base" "$pg_head"
    ;;
  policy-load)
    nse_require_cmd jq awk
    [ -n "$pg_policy" ] || { printf 'nse-pg: policy-load needs --policy FILE\n' >&2; exit "$NSE_PG_USAGE"; }
    if [ -n "$pg_out" ]; then nse_pg_policy_load "$pg_policy" "$pg_policy_rev" | nse_pg_write_json "$pg_out"
    else nse_pg_policy_load "$pg_policy" "$pg_policy_rev"; fi
    ;;
  decide)
    nse_require_cmd jq awk
    { [ -n "$pg_facts" ] && [ -n "$pg_policy" ]; } \
      || { printf 'nse-pg: decide needs --facts FILE and --policy FILE\n' >&2; exit "$NSE_PG_USAGE"; }
    pg_loaded=$pg_policy
    case $pg_policy in
      *.toml) pg_loaded=$(mktemp "${TMPDIR:-/tmp}/nse-pg-policy.XXXXXX.json")
              nse_pg_policy_load "$pg_policy" "$pg_policy_rev" > "$pg_loaded" ;;
    esac
    if [ -n "$pg_out" ]; then nse_pg_decide "$pg_facts" "$pg_loaded" | nse_pg_write_json "$pg_out"
    else nse_pg_decide "$pg_facts" "$pg_loaded"; fi
    ;;
  gate)
    nse_require_cmd jq awk
    { [ -n "$pg_trusted_root" ] && [ -n "$pg_candidate_root" ]; } \
      || { printf 'nse-pg: gate needs --trusted-root DIR and --candidate-root DIR\n' >&2
           printf 'nse-pg: they are two INPUTS on purpose. A gate that derives one from the\n' >&2
           printf 'nse-pg: other has one root, and the candidate can edit it.\n' >&2
           exit "$NSE_PG_USAGE"; }
    : "${pg_out:=$pg_candidate_root/gate-report.json}"
    nse_pg_gate "$pg_trusted_root" "$pg_candidate_root" "$pg_out" \
                "$pg_trusted_rev" "$pg_candidate_rev"
    ;;
  *) printf 'nse-pg: unknown command %s\n' "$cmd" >&2; usage; exit "$NSE_PG_USAGE" ;;
esac
