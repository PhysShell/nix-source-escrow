#!/usr/bin/env bash
#
# nix-source-escrow -- keep the sources a Nix build depends on in storage you
# control, and prove with a test that the build survives the death of their
# origins.
#
# Guarantees: ESCROW_REPLAY (default) and SOURCE_ORIGIN_INDEPENDENCE.
# See README.md and DESIGN.md.

set -euo pipefail

NSE_SELF=${BASH_SOURCE[0]}
while [ -L "$NSE_SELF" ]; do NSE_SELF=$(readlink -f "$NSE_SELF"); done
NSE_ROOT=$(cd "$(dirname "$NSE_SELF")/.." && pwd)

# shellcheck source=../lib/common.sh
. "$NSE_ROOT/lib/common.sh"
# shellcheck source=../lib/discover.sh
. "$NSE_ROOT/lib/discover.sh"
# shellcheck source=../lib/preserve.sh
. "$NSE_ROOT/lib/preserve.sh"
# shellcheck source=../lib/verify.sh
. "$NSE_ROOT/lib/verify.sh"
# shellcheck source=../lib/prove.sh
. "$NSE_ROOT/lib/prove.sh"
# shellcheck source=../lib/trust.sh
. "$NSE_ROOT/lib/trust.sh"
# shellcheck source=../lib/report.sh
. "$NSE_ROOT/lib/report.sh"

usage() {
  cat >&2 <<'USAGE'
usage: nix-source-escrow <command> [<installable>] [options]

commands:
  env                             report the Nix environment this runs in
  discover <installable>          enumerate flake inputs and fixed-output sources
  preserve <installable>          realise the build in a controlled store and
                                  copy everything it needed into the escrow
  verify   <installable>          check the escrow holds the right objects
  trust-probe                     measure which escrowed objects Nix accepts unsigned
  test-origin-independence <inst> build with every origin unreachable
  report                          print the evidence report
  escrow   <installable>          discover + preserve + verify + test + report

escrow location (a URL, not necessarily a directory):
  --escrow-dir DIR        local escrow root (default: ./escrow, or $NSE_DIR).
                          Sets the default store/substituter URLs below.
  --escrow-store URL      where PRESERVE writes: file://, s3://, ssh-ng://, or
                          any Nix store URL. An Attic / S3 / Artifactory Nix
                          repository is a first-class target.
  --escrow-substituter URL  what VERIFY and PROVE read from
                          (default: the store URL without its query string)
  --binary-tier URL       SOURCE_ORIGIN_INDEPENDENCE only: the approved binary
                          cache the prebuilt tier must actually come from
                          (default: https://cache.nixos.org). Objects are
                          copied into the replica FROM HERE, never from the
                          staging build -- see DESIGN.md §12.
  --binary-replica URL    where that tier is replicated to for the offline test
                          (default: file://<escrow-dir>/replica)
  --proof-replica DIR     local store the acceptance test replays from when the
                          escrow substituter is remote
                          (default: <escrow-dir>/work/proof-replica)
  --compression C         binary-cache compression: zstd|xz|none (default: zstd)

guarantee:
  --guarantee NAME        escrow-replay (default)
                            escrow the whole realised closure; the acceptance
                            test allows the escrow and nothing else.
                          source-origin-independence
                            escrow source material only; the acceptance test
                            also allows the binary replica. Cheaper, weaker,
                            and named so nobody confuses the two.

acceptance test:
  --expect-fail           assert the build FAILS (negative control for a
                          deliberately incomplete escrow)
  --no-isolation          run without namespaces (debug only; the result is
                          marked a control run, never an acceptance)

other:
  --staging-dir DIR       the controlled store PRESERVE builds into
                          (default: <escrow-dir>/work/staging). Point several
                          escrows at one staging store and the closure is
                          fetched once, not once per escrow.
  --fresh-staging         wipe the staging store before preserving
  -h, --help              this text

exit status: 0 on success, 1 on a failed check, 2 on usage error.
USAGE
}

NSE_DIR=${NSE_DIR:-$PWD/escrow}
NSE_COMPRESSION=${NSE_COMPRESSION:-zstd}
NSE_FRESH_STAGING=0
NSE_NO_ISOLATION=0
nse_staging_opt=${NSE_STAGING:-}
NSE_EXPECT=pass
NSE_INSTALLABLE=""
NSE_GUARANTEE=${NSE_GUARANTEE:-escrow-replay}
# Defaults set by measurement, not by caution: experiments E1/E2/E3 came back
# CONFIRMED on Nix 2.34.7 (evidence/experiments.json). Both workarounds are off.
nse_store_url_opt=${NSE_STORE_URL:-}
nse_substituter_opt=${NSE_SUBSTITUTER_URL:-}
nse_replica_opt=${NSE_REPLICA_URL:-}
nse_tier_opt=${NSE_BINARY_TIER:-}
nse_proof_opt=${NSE_PROOF_REPLICA:-}

[ $# -ge 1 ] || { usage; exit 2; }
case $1 in
  -h|--help|help) usage; exit 0 ;;
esac
cmd=$1; shift

need_value() {
  [ "$1" -ge 2 ] || { printf 'nix-source-escrow: %s needs a value\n' "$2" >&2; exit 2; }
}

while [ $# -gt 0 ]; do
  case $1 in
    --escrow-dir) need_value $# "$1"; NSE_DIR=$(nse_abspath "$2"); shift 2 ;;
    --escrow-store) need_value $# "$1"; nse_store_url_opt=$2; shift 2 ;;
    --escrow-substituter) need_value $# "$1"; nse_substituter_opt=$2; shift 2 ;;
    --binary-replica) need_value $# "$1"; nse_replica_opt=$2; shift 2 ;;
    --binary-tier) need_value $# "$1"; nse_tier_opt=$2; shift 2 ;;
    --proof-replica) need_value $# "$1"; nse_proof_opt=$(nse_abspath "$2"); shift 2 ;;
    --guarantee) need_value $# "$1"
                 case $2 in
                   escrow-replay|source-origin-independence) NSE_GUARANTEE=$2 ;;
                   *) printf 'nix-source-escrow: unknown guarantee %s\n' "$2" >&2; exit 2 ;;
                 esac
                 shift 2 ;;
    --compression) need_value $# "$1"
                  case $2 in zstd|xz|none) NSE_COMPRESSION=$2 ;;
                    *) printf 'nix-source-escrow: unsupported compression %s\n' "$2" >&2; exit 2 ;; esac
                  shift 2 ;;
    --staging-dir) need_value $# "$1"; nse_staging_opt=$(nse_abspath "$2"); shift 2 ;;
    --fresh-staging) NSE_FRESH_STAGING=1; shift ;;
    --expect-fail)   NSE_EXPECT=fail; shift ;;
    --no-isolation)  NSE_NO_ISOLATION=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) printf 'nix-source-escrow: unknown option %s\n' "$1" >&2; usage; exit 2 ;;
    *) if [ -z "$NSE_INSTALLABLE" ]; then NSE_INSTALLABLE=$1; shift
       else printf 'nix-source-escrow: unexpected argument %s\n' "$1" >&2; exit 2; fi ;;
  esac
done

NSE_DIR=$(nse_abspath "$NSE_DIR")
NSE_CACHE=$NSE_DIR/cache

# The local file:// cache is the default backend and the demo backend. It is
# not the only one: every stage addresses the escrow through these URLs.
NSE_STORE_URL=${nse_store_url_opt:-$(nse_default_store_url)}
NSE_SUBSTITUTER_URL=${nse_substituter_opt:-$(nse_url_strip_query "$NSE_STORE_URL")}
NSE_REPLICA_URL=${nse_replica_opt:-file://$NSE_DIR/replica}
NSE_STAGING=${nse_staging_opt:-$NSE_DIR/work/staging}
NSE_BINARY_TIER=${nse_tier_opt:-https://cache.nixos.org}
NSE_PROOF_REPLICA=${nse_proof_opt:-$NSE_DIR/work/proof-replica}

export NSE_DIR NSE_CACHE NSE_COMPRESSION NSE_FRESH_STAGING NSE_NO_ISOLATION \
       NSE_INSTALLABLE NSE_STORE_URL NSE_SUBSTITUTER_URL NSE_REPLICA_URL \
       NSE_GUARANTEE NSE_STAGING \
       NSE_BINARY_TIER NSE_PROOF_REPLICA

nse_require_cmd nix jq

need_installable() {
  [ -n "$NSE_INSTALLABLE" ] \
    || { printf 'nix-source-escrow: %s needs an installable, e.g. ".#default"\n' "$cmd" >&2; exit 2; }
}

mkdir -p "$NSE_DIR" "$NSE_DIR/evidence"

case $cmd in
  env)      nse_env ;;
  discover) need_installable; nse_discover ;;
  preserve) need_installable; nse_preserve ;;
  verify)   need_installable; nse_verify ;;
  trust-probe) nse_trust_probe ;;
  test-origin-independence) need_installable; nse_prove "$NSE_EXPECT" ;;
  report)   nse_report ;;
  escrow)   need_installable; nse_escrow_pipeline ;;
  *) printf 'nix-source-escrow: unknown command %s\n' "$cmd" >&2; usage; exit 2 ;;
esac
